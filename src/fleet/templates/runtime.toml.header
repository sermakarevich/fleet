# Runtime configuration for the fleet supervisor.
# Edit via `fleet config set <key>=<value>`. The supervisor re-reads this
# file periodically and applies changes without restart.
# In-flight subprocesses are NEVER killed by a config change.
#
# telegram_chat_id: Telegram chat/channel ID for supervisor notifications.
#   Empty string (default) disables Telegram notifications.
#   The bot token is supplied via the TELEGRAM_BOT_TOKEN env var (never stored here).
#
# telegram_allowed_ids: Comma-separated numeric Telegram user/chat IDs that may
#   create fleet tasks by messaging the bot with /task commands.
#   Empty string (default) disables the inbound listener entirely (default-deny).
#   Example: "123456789,987654321"
#
# telegram_default_cwd: Working directory assigned to tasks created via Telegram.
#   Empty string (default) leaves cwd unset on the created task.
#
# opencode_ollama_url: Base URL of the Ollama API used by the "opencode" coder.
#   Defaults to http://127.0.0.1:11435/v1 (ssh tunnel to rtx GPU box).
#   Override to point at a different Ollama instance, e.g. http://127.0.0.1:11434/v1
#   for a local Ollama install.
#   Set via: fleet config set opencode_ollama_url=http://...
#
# opencode_bedrock_region: AWS Bedrock region for Claude-on-Bedrock.
#   Empty string (default) inherits region from environment/AWS config.
#   Set via: fleet config set opencode_bedrock_region=us-east-1
#
# opencode_bedrock_profile: AWS profile name for Bedrock credentials.
#   Empty string (default) inherits credentials from the environment.
#   Set via: fleet config set opencode_bedrock_profile=dev
#
# context_windows: Per-model context windows as "model:tokens,model:tokens".
#   Used as the denominator for the context-usage display and the
#   checkpoint/kill thresholds, for supervisor and UI alike.
#   Empty string (default) uses the built-in table in core/context_window.py
#   (e.g. muse-spark-1.3-contributor: 1048576, claude/bedrock: 200000,
#   local qwen: 65000, gpt-oss: 128000).
#   Set via: fleet config set context_windows="muse-spark-1.3-contributor:1048576".
#
# compaction_enabled: Run the Compact step before continue launches whose
#   pack needs compaction (ContinueLargeTask). true (default) or false.
#
# compaction_coder: Coder CLI used for the cheap compaction model call.
#   Defaults to claude.
#
# compaction_model: Model used for the cheap compaction model call.
#   Defaults to haiku.
#
# context_checkpoint_pct: Peak-context percent at which the runner writes
#   .checkpoint_requested so the model wraps up early. Defaults to 75.
#
# context_kill_pct: Peak-context percent at which the runner kills the
#   session and reports CONTEXT_PRESSURE. Defaults to 90.
#
# isolation: Git worktree isolation mode: "worktree" (default) or "none".
#   "worktree" runs tasks whose cwd is inside a git repo in an isolated
#   worktree at $FLEET_HOME/worktrees/<repo>-<task_id> on branch
#   fleet/<task_id>; tasks outside a repo always run in place.
#   Set via: fleet config set isolation=none
#
# post_merge_command: Shell command run in the repo root after a worktree
#   branch merges cleanly into its base branch (10-minute timeout).
#   Empty string (default) skips the step. A repo that needs a build gate
#   (e.g. fleet itself) sets e.g. "make ui-build" via config, not code.
#   On failure the bead blocks with the command's last 40 lines of output.
#   Set via: fleet config set post_merge_command="make ui-build"
