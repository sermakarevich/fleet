# Runtime configuration for the fleet supervisor.
# Edit via `fleet config set <key>=<value>`. The supervisor re-reads this
# file periodically and applies changes without restart.
# In-flight subprocesses are NEVER killed by a config change.
#
# Full reference with defaults: docs/CONFIG.md (generated from the same
# metadata by `fleet config docs --write`; do not edit this header by hand).
#
#
# max_concurrent: Maximum agent subprocesses running at once.
#   Default 3; e.g. fleet config set max_concurrent=5
#
# model: Default model when a task sets no override.
#   Default "sonnet"; e.g. fleet config set model=opus
#
# coder: Default coder CLI when a task sets no override.
#   Default "claude"; e.g. fleet config set coder=codex
#
# telegram_chat_id: Telegram chat ID for notifications; empty disables them.
#   Default ""; e.g. fleet config set telegram_chat_id=-1001234567890
#
# telegram_allowed_ids: Telegram sender IDs allowed inbound commands; empty disables all.
#   Default ""; e.g. fleet config set telegram_allowed_ids=123456789,987654321
#
# telegram_default_cwd: Working directory for tasks created via Telegram; empty leaves unset.
#   Default ""; e.g. fleet config set telegram_default_cwd=/Users/you/git/myproject
#
# opencode_ollama_url: Ollama API base URL used by the opencode coder.
#   Default "http://127.0.0.1:11435/v1"; e.g. fleet config set opencode_ollama_url=http://127.0.0.1:11434/v1
#
# ollama_ssh_host: SSH host alias for the GPU box behind opencode_ollama_url.
#   Default "rtx"; e.g. fleet config set ollama_ssh_host=gpubox
#
# ollama_remote_port: Ollama port on the GPU box (remote end of the tunnel).
#   Default 11434; e.g. fleet config set ollama_remote_port=11434
#
# max_concurrent_overrides: Per-coder limits as coder:limit pairs; others use max_concurrent.
#   Default ""; e.g. fleet config set max_concurrent_overrides=claude:2,opencode:4
#
# context_windows: Per-model context windows as model:tokens pairs; empty uses built-ins.
#   Default ""; e.g. fleet config set context_windows=muse-spark-1.3-contributor:1048576
#
# opencode_default_model: Ollama model for opencode tasks without an override.
#   Default "qwen3.6:latest"; e.g. fleet config set opencode_default_model=qwen3.5:27b
#
# opencode_bedrock_region: AWS region for Bedrock; empty inherits the environment.
#   Default ""; e.g. fleet config set opencode_bedrock_region=us-east-1
#
# opencode_bedrock_profile: AWS profile for Bedrock; empty inherits the environment.
#   Default ""; e.g. fleet config set opencode_bedrock_profile=dev
#
# stall_warning_minutes: Silence minutes before an attempt counts as stalled.
#   Default 15; e.g. fleet config set stall_warning_minutes=30
#
# stall_action: Stall response: warn logs only, kill stops the attempt.
#   Default "kill"; e.g. fleet config set stall_action=warn
#
# max_attempt_minutes: Wall-clock cap per attempt; 0 disables. Over budget kills.
#   Default 120; e.g. fleet config set max_attempt_minutes=60
#
# continue_pack_max_bytes: Pack budget in bytes before a continue launch compacts.
#   Default 8192; e.g. fleet config set continue_pack_max_bytes=16384
#
# state_max_bytes: Hard cap on the worker-memory file STATE.md in bytes.
#   Default 6144; e.g. fleet config set state_max_bytes=8192
#
# compaction_enabled: Compact before continue launches that need it; else truncate.
#   Default true; e.g. fleet config set compaction_enabled=false
#
# compaction_coder: Coder CLI used for the cheap compaction call.
#   Default "claude"; e.g. fleet config set compaction_coder=claude
#
# compaction_model: Model used for the cheap compaction call.
#   Default "haiku"; e.g. fleet config set compaction_model=haiku
#
# context_checkpoint_pct: Peak-context percent that asks the model to wrap up early.
#   Default 75; e.g. fleet config set context_checkpoint_pct=80
#
# context_kill_pct: Peak-context percent that kills with CONTEXT_PRESSURE.
#   Default 90; e.g. fleet config set context_kill_pct=95
#
# isolation: Git worktree isolation: worktree isolates repo tasks, none runs in place.
#   Default "worktree"; e.g. fleet config set isolation=none
#
# isolation_exclude: Repo roots that never get a worktree; empty excludes none.
#   Default ""; e.g. fleet config set isolation_exclude=/Users/me/.ai
#
# post_merge_command: Shell command after a clean worktree merge; empty skips.
#   Default ""; e.g. fleet config set post_merge_command=make ui-build
#
# triage_interval_minutes: Minutes between blocked-task triage scans; 0 disables.
#   Default 15; e.g. fleet config set triage_interval_minutes=30
#
# gc_retention_days: Days before closed tasks archive; 0 disables archiving.
#   Default 30; e.g. fleet config set gc_retention_days=7
#
# gc_archive_days: Days before archives delete permanently; 0 disables purging.
#   Default 90; e.g. fleet config set gc_archive_days=30
#
# observer_max_followups: Max follow-up tasks opened per observer validation round.
#   Default 10; e.g. fleet config set observer_max_followups=5
#
# observer_max_rounds: Max partial observer rounds before human review.
#   Default 3; e.g. fleet config set observer_max_rounds=5
#
# job_gate: Ask approval before a job spawns its planned children.
#   Default true; e.g. fleet config set job_gate=false
#
# job_child_coder: Default coder for job-spawned child tasks.
#   Default "claude"; e.g. fleet config set job_child_coder=opencode
#
# job_child_model: Default model for job-spawned child tasks.
#   Default "sonnet"; e.g. fleet config set job_child_model=opus
#
# job_max_children: Max children one job phase may spawn.
#   Default 30; e.g. fleet config set job_max_children=10
#
# job_max_phase_attempts: Max research/design attempts before a job blocks.
#   Default 2; e.g. fleet config set job_max_phase_attempts=3
#
# serve_cors_origins: Browser origins allowed cross-origin; empty is same-origin only.
#   Default []; e.g. fleet config set serve_cors_origins=https://fleet.example.com
#
# serve_host: UI server bind address; 0.0.0.0 exposes LAN, 127.0.0.1 local only.
#   Default "0.0.0.0"; e.g. fleet config set serve_host=127.0.0.1
#
# serve_port: UI server port.
#   Default 7890; e.g. fleet config set serve_port=8080
